{
  "uid": "goph-infrastructure",
  "title": "GophProfile — Infrastructure",
  "description": "Пул соединений PostgreSQL, очереди RabbitMQ и ресурсы процессов.",
  "tags": [
    "gophprofile",
    "infrastructure"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Соединения с БД",
      "description": "Пул соединений PostgreSQL сервера и воркера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avatars_db_acquired_conns{job=~\"goph-.*\"}",
          "legendFormat": "занято {{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avatars_db_idle_conns{job=~\"goph-.*\"}",
          "legendFormat": "свободно {{job}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avatars_db_total_conns{job=~\"goph-.*\"}",
          "legendFormat": "всего {{job}}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avatars_db_max_conns{job=~\"goph-.*\"}",
          "legendFormat": "максимум пула {{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ожидание соединения из пула",
      "description": "Ожидание свободного соединения в пулах сервера и воркера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(avatars_db_acquire_duration_seconds_total{job=~\"goph-.*\"}[5m])",
          "legendFormat": "секунд ожидания в секунду {{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(avatars_db_empty_acquire_count_total{job=~\"goph-.*\"}[5m])",
          "legendFormat": "пустых захватов в секунду {{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Глубина очередей RabbitMQ",
      "description": "Готовые к доставке сообщения — рост означает отставание воркера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avatars_queue_messages",
          "legendFormat": "{{queue}}"
        }
