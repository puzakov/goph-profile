HTTP_ADDR=:8080

DATABASE_URL=postgres://goph:goph@localhost:5433/goph?sslmode=disable

STATIC_DIR=./web/static

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_REGION=us-east-1
S3_USE_SSL=false

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Наблюдаемость: логи, трейсинг, метрики.
LOG_LEVEL=info
LOG_FORMAT=json
# Пусто — трейсинг выключен (спаны не экспортируются).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Адрес /metrics воркера (сервер отдаёт метрики на HTTP_ADDR).
METRICS_ADDR=:9091
# Пусто — метрики очередей не собираются.
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=guest
RABBITMQ_MANAGEMENT_PASSWORD=guest
